/docs/ANDROID_INSTALL.md text eol=lf
/docs/CONTROLS.md text eol=lf
/docs/BUILDING.md text eol=lf
/docs/CHANGES.md text eol=lf
/LICENSES/** text eol=lf
/docs/images/*.png binary
