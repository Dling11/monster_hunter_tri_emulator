# Accept Docker-produced translation only when its sources and artifacts match.
# This keeps Python and .NET inside Docker; the default native gate is unchanged.
function(mh3_validate_docker_translation)
  if(NOT WIN32)
    message(FATAL_ERROR "MH3_USE_DOCKER_TRANSLATION currently exports Windows x86-64 artifacts only")
  endif()
  get_filename_component(mh3_root "${CMAKE_CURRENT_SOURCE_DIR}/.." ABSOLUTE)
  set(mh3_marker "${mh3_root}/generated/docker-windows-ready.json")
  if(NOT EXISTS "${mh3_marker}")
    message(FATAL_ERROR "Docker translation is missing. Run .\\dev.ps1 -Mode Translate first.")
  endif()
  file(READ "${mh3_marker}" mh3_manifest)
  string(JSON mh3_format GET "${mh3_manifest}" format)
  string(JSON mh3_export_root GET "${mh3_manifest}" windowsRoot)
  string(TOLOWER "${mh3_export_root}" mh3_export_root_lower)
  string(TOLOWER "${mh3_root}" mh3_root_lower)
  if(NOT mh3_format EQUAL 1 OR NOT mh3_export_root_lower STREQUAL mh3_root_lower)
    message(FATAL_ERROR "Docker translation belongs to a different checkout. Run .\\dev.ps1 -Mode Translate.")
  endif()

  set(mh3_recorded_inputs)
  foreach(mh3_group IN ITEMS inputs outputs)
    set(mh3_hash_list "${mh3_root}/generated/docker-${mh3_group}.sha256")
    if(NOT EXISTS "${mh3_hash_list}")
      message(FATAL_ERROR "Missing Docker hash list. Run .\\dev.ps1 -Mode Translate.")
    endif()
    string(JSON mh3_expected GET "${mh3_manifest}" hashLists "${mh3_group}")
    file(SHA256 "${mh3_hash_list}" mh3_actual)
    if(NOT mh3_actual STREQUAL mh3_expected)
      message(FATAL_ERROR "Docker hash list changed. Run .\\dev.ps1 -Mode Translate.")
    endif()
    file(STRINGS "${mh3_hash_list}" mh3_records)
    if(NOT mh3_records)
      message(FATAL_ERROR "Empty ${mh3_group} in Docker translation manifest")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${mh3_hash_list}")
    foreach(mh3_record IN LISTS mh3_records)
      if(NOT mh3_record MATCHES "^([a-f0-9]+)  (.+)$")
        message(FATAL_ERROR "Invalid record in Docker hash list")
      endif()
      set(mh3_expected "${CMAKE_MATCH_1}")
      set(mh3_relative "${CMAKE_MATCH_2}")
      if(mh3_relative MATCHES "(^|/)\\.\\.(/|$)|^/|:")
        message(FATAL_ERROR "Invalid relative path in Docker manifest: ${mh3_relative}")
      endif()
      if(mh3_group STREQUAL "inputs")
        set(mh3_file "${mh3_root}/${mh3_relative}")
        list(APPEND mh3_recorded_inputs "${mh3_relative}")
      else()
        set(mh3_file "${mh3_root}/generated/${mh3_relative}")
      endif()
      if(NOT EXISTS "${mh3_file}")
        message(FATAL_ERROR "Missing translation input/output: ${mh3_file}. Run .\\dev.ps1 -Mode Translate.")
      endif()
      file(SHA256 "${mh3_file}" mh3_actual)
      if(NOT mh3_actual STREQUAL mh3_expected)
        message(FATAL_ERROR "Changed translation input/output: ${mh3_file}. Run .\\dev.ps1 -Mode Translate.")
      endif()
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${mh3_file}")
    endforeach()
  endforeach()
  # Detect added sources too, rather than validating only files known last time.
  file(GLOB_RECURSE mh3_current_inputs CONFIGURE_DEPENDS RELATIVE "${mh3_root}"
    "${mh3_root}/runtime/src/*.cpp" "${mh3_root}/runtime/src/*.h" "${mh3_root}/runtime/src/*.hpp"
    "${mh3_root}/runtime/include/*.h" "${mh3_root}/runtime/include/*.hpp"
    "${mh3_root}/runtime/native/*.c" "${mh3_root}/runtime/native/*.h"
    "${mh3_root}/toolchain/*.cs" "${mh3_root}/toolchain/*.csproj"
    "${mh3_root}/toolchain/*.props" "${mh3_root}/toolchain/*.targets"
    "${mh3_root}/scripts/*.py")
  list(FILTER mh3_current_inputs EXCLUDE REGEX "/(bin|obj|__pycache__)/")
  list(APPEND mh3_current_inputs recomp.yml symbols.txt runtime/CMakeLists.txt
    cmake/DockerTranslation.cmake docker/translation.Dockerfile)
  list(SORT mh3_current_inputs)
  list(SORT mh3_recorded_inputs)
  if(NOT mh3_current_inputs STREQUAL mh3_recorded_inputs)
    message(FATAL_ERROR "Translation source list changed. Run .\\dev.ps1 -Mode Translate.")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${mh3_marker}")
  message(STATUS "Validated Docker translation: source files and generated artifact hashes match")
endfunction()

