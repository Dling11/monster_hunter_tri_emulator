+    void ApplyComboMasks() {
+        static const char* names[] = {"A", "B", "X", "Y", "L", "R", "ZL", "ZR"};
+        static const uint16_t bits[] = {MH3_CL_A, MH3_CL_B, MH3_CL_X, MH3_CL_Y,
+            MH3_CL_L, MH3_CL_R, MH3_CL_ZL, MH3_CL_ZR};
+        for (auto& b : m_buttons) {
+            if (b.id.size()!=2 || b.id[0]!='M' || b.id[1]<'1' || b.id[1]>'5') continue;
+            b.mask = m_comboMasks[b.id[1]-'1']; b.label.clear();
+            for (int i=0;i<8;++i) if (b.mask & bits[i]) {
+                if (!b.label.empty()) b.label += "+";
+                b.label += names[i];
+            }
+            if (b.label.empty()) b.label = "Empty";
+            if (b.mask==(MH3_CL_R|MH3_CL_X|MH3_CL_A)) b.label="R+X+A";
+        }
+    }
+    bool& ComboEnabled(int i) {
+        switch(i) { case 0:return m_macro1Enabled; case 1:return m_macro2Enabled;
+          case 2:return m_macro3Enabled; case 3:return m_macro4Enabled; default:return m_macro5Enabled; }
+    }
+    void RenderTabCombos(float x, float y, float w) {
+        DrawText(x, y, "Combo buttons", 23, COL_WHITE);
+        DrawText(x, y+32, "Select a slot, then select its buttons. Hold a combo to press them together.", 14, COL_MUTED);
+        float sw=(w-40)/5;
+        for (int i=0;i<5;++i) {
+            float bx=x+i*(sw+10); char title[24]; std::snprintf(title,sizeof(title),"Combo %d",i+1);
+            DrawRoundedRect(bx,y+62,sw,44,8,m_comboEdit==i?COL_ACTIVE_CHIP:COL_INACTIVE_CHIP,COL_CYAN);
+            DrawText(bx+sw/2,y+75,title,16,m_comboEdit==i?COL_ACTIVE_TEXT:COL_WHITE,true);
+        }
+        DrawRoundedRect(x,y+123,w,44,8,COL_INACTIVE_CHIP,COL_CHIP_BORDER);
+        DrawText(x+18,y+136,ComboEnabled(m_comboEdit)?"Enabled - tap to hide this combo":"Hidden - tap to enable this combo",16,COL_WHITE);
+        const char* names[]={"A","B","X","Y","L","R","ZL","ZR"};
+        const uint16_t bits[]={MH3_CL_A,MH3_CL_B,MH3_CL_X,MH3_CL_Y,MH3_CL_L,MH3_CL_R,MH3_CL_ZL,MH3_CL_ZR};
+        float bw=(w-30)/4;
+        for(int i=0;i<8;++i) {
+            float bx=x+(i%4)*(bw+10), by=y+190+(i/4)*58;
+            bool on=(m_comboMasks[m_comboEdit]&bits[i])!=0;
+            DrawRoundedRect(bx,by,bw,46,8,on?COL_ACTIVE_CHIP:COL_INACTIVE_CHIP,COL_CHIP_BORDER);
+            DrawText(bx+bw/2,by+14,names[i],18,on?COL_ACTIVE_TEXT:COL_WHITE,true);
+        }
+        DrawText(x,y+322,"Changes save automatically. Drag and resize combos in Controls > Edit layout.",14,COL_MUTED);
+        DrawText(x,y+352,"Three or more fingers work together. Each finger releases independently.",14,COL_CYAN);
+    }
+    bool HandleComboTap(float px,float py,float x,float y,float w) {
+        float sw=(w-40)/5;
+        if(py>=y+62 && py<=y+106) for(int i=0;i<5;++i) {
+            float bx=x+i*(sw+10); if(px>=bx && px<=bx+sw) {m_comboEdit=i;return true;}
+        }
+        if(py>=y+123 && py<=y+167 && px>=x && px<=x+w) {
+            ComboEnabled(m_comboEdit)=!ComboEnabled(m_comboEdit); ResetInput(); SaveLayoutConfig(); return true;
+        }
+        const uint16_t bits[]={MH3_CL_A,MH3_CL_B,MH3_CL_X,MH3_CL_Y,MH3_CL_L,MH3_CL_R,MH3_CL_ZL,MH3_CL_ZR};
+        float bw=(w-30)/4;
+        for(int i=0;i<8;++i) {
+            float bx=x+(i%4)*(bw+10),by=y+190+(i/4)*58;
+            if(px>=bx && px<=bx+bw && py>=by && py<=by+46) {
+                m_comboMasks[m_comboEdit]^=bits[i]; ResetInput(); ApplyComboMasks(); SaveLayoutConfig(); return true;
+            }
+        }
+        return false;
     }
 
