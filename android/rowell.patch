+    void DrawClippedText(float x,float y,std::string text,float size,float width,Color color) {
+        if(MeasureText(text.c_str(),size)>width) {
+            const float limit=width-MeasureText("...",size);
+            while(!text.empty() && MeasureText(text.c_str(),size)>limit) {
+                size_t end=text.size()-1;while(end && (static_cast<unsigned char>(text[end])&0xc0)==0x80)--end;
+                text.resize(end);
+            }
+            text+="...";
+        }
+        DrawText(x,y,text.c_str(),size,color);
+    }
